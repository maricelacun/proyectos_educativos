    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', 'Segoe UI', system-ui, -apple-system, 'Inter', sans-serif;
            background-color: #FFF9F0; /* base cálida */
            color: #1E2A3E;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        /* Fondo decorativo de circuitos (coloridos) */
        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" opacity="0.08"><path fill="none" stroke="%23FF3B3F" stroke-width="1.5" d="M20 80 L45 80 L55 60 L80 60 M120 40 L140 40 L150 60 L180 60 M30 140 L55 140 L65 160 L90 160 M150 130 L170 130 L180 110 L195 110"/><circle cx="80" cy="60" r="3" fill="%23FFB800"/><circle cx="150" cy="60" r="3" fill="%23007BFF"/><circle cx="90" cy="160" r="3" fill="%23FF6B35"/></svg>');
            background-repeat: repeat;
            pointer-events: none;
            z-index: -1;
        }

        section {
            padding: 80px 5%;
            max-width: 1400px;
            margin: 0 auto;
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.7s ease, transform 0.7s ease;
        }
        section.visible {
            opacity: 1;
            transform: translateY(0);
        }
        h2 {
            font-size: 2.4rem;
            margin-bottom: 1rem;
            position: relative;
            display: inline-block;
            background: linear-gradient(135deg, #FF3B3F, #FFB800, #007BFF);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            font-weight: 800;
        }
        h2:after {
            content: '';
            position: absolute;
            bottom: -12px;
            left: 0;
            width: 80px;
            height: 5px;
            background: #FF6B35;
            border-radius: 10px;
        }
        .grid-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
            margin-top: 40px;
        }
        .card {
            background: white;
            border-radius: 32px;
            padding: 25px 20px;
            box-shadow: 0 20px 30px -12px rgba(0,0,0,0.15);
            transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            border-left: 8px solid #FFB800;
            border-bottom: 2px solid #FF3B3F20;
        }
        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 40px -12px #FF3B3F40;
            border-left-color: #FF3B3F;
        }
        .btn {
            background: linear-gradient(95deg, #FF3B3F, #FF6B35);
            border: none;
            padding: 14px 36px;
            border-radius: 60px;
            color: white;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            display: inline-block;
            text-decoration: none;
            font-size: 1rem;
            box-shadow: 0 8px 18px rgba(255, 59, 63, 0.3);
        }
        .btn:hover {
            transform: scale(1.05);
            box-shadow: 0 15px 28px rgba(255, 107, 53, 0.5);
            background: linear-gradient(95deg, #FF6B35, #FFB800);
        }

        /* Hero con colores vibrantes */
        .hero {
            background: linear-gradient(125deg, #FF3B3F 0%, #FFB800 50%, #007BFF 100%);
            padding: 100px 5% 120px;
            clip-path: polygon(0 0, 100% 0, 100% 90%, 0 100%);
            position: relative;
            color: white;
        }
        .hero-content {
            max-width: 800px;
            margin: 0 auto;
            text-align: center;
        }
        .hero h1 {
            font-size: 3.3rem;
            font-weight: 800;
            background: linear-gradient(135deg, #FFFFFF, #FFF5B0);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            text-shadow: 2px 2px 8px rgba(0,0,0,0.2);
        }

        /* timeline viva */
        .timeline {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
            margin-top: 40px;
        }
        .step {
            background: white;
            border-radius: 60px;
            padding: 15px 28px;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 8px 18px rgba(0,0,0,0.1);
            border: 1px solid #FFB800;
            color: #FF3B3F;
        }
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 25px;
        }
        .rec-item, .project-card {
            background: white;
            border-radius: 28px;
            text-align: center;
            padding: 24px 12px;
            transition: all 0.3s;
            box-shadow: 0 10px 20px rgba(0,0,0,0.05);
            border-top: 4px solid #007BFF;
        }
        .rec-item i, .project-card i {
            font-size: 3rem;
            color: #FF6B35;
        }
        .rec-item:hover {
            background: #FFF2CC;
            transform: scale(1.02);
        }
        .rubrica-table {
            background: white;
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 15px 30px rgba(0,0,0,0.08);
            width: 100%;
            border-collapse: collapse;
        }
        .rubrica-table th {
            background-color: #FFB800;
            color: #1E2A3E;
        }
        .rubrica-table td, .rubrica-table th {
            padding: 16px 20px;
            border-bottom: 1px solid #FFDD99;
        }
        .quiz-container {
            background: white;
            border-radius: 32px;
            padding: 30px;
            box-shadow: 0 20px 30px rgba(255, 59, 63, 0.1);
        }
        .question {
            background: #FFF6E5;
            margin-bottom: 18px;
            padding: 18px;
            border-radius: 24px;
            border-left: 6px solid #FF3B3F;
        }
        footer {
            background: #1E2A3E;
            color: white;
            padding: 40px 5%;
            text-align: center;
            border-top: 6px solid #FFB800;
        }
        .circuit-svg {
            background: #2A2F3F;
            border-radius: 36px;
            padding: 25px;
            margin-top: 20px;
            box-shadow: 0 15px 25px rgba(0,0,0,0.2);
        }
        @keyframes flowPulse {
            0% { opacity: 0.3; filter: drop-shadow(0 0 0px #FFB800);}
            100% { opacity: 1; filter: drop-shadow(0 0 10px #FF3B3F);}
        }
        .flow-dot {
            animation: flowPulse 1s infinite alternate;
        }
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.8);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }
        .modal-content {
            background: linear-gradient(145deg, white, #FFF2CC);
            max-width: 450px;
            border-radius: 32px;
            padding: 32px;
            text-align: center;
            border: 3px solid #FFB800;
        }
        @media (max-width: 768px) {
            h2 { font-size: 1.8rem; }
            .hero h1 { font-size: 2.2rem; }
        }
        .badge-dif {
            background: #FF3B3F20;
            border-radius: 40px;
            padding: 5px 14px;
            font-size: 0.8rem;
            display: inline-block;
            margin-top: 10px;
            font-weight: bold;
            color: #FF3B3F;
        }
        button.accordion {
            background-color: #FFE0B5;
            cursor: pointer;
            padding: 18px;
            width: 100%;
            text-align: left;
            border: none;
            border-radius: 50px;
            font-weight: bold;
            margin-bottom: 10px;
            color: #B13E00;
            transition: 0.2s;
        }
        button.accordion:hover {
            background-color: #FFB347;
            color: white;
        }
        .panel {
            padding: 0 18px;
            display: none;
            background-color: #FFFEF7;
            border-radius: 28px;
            margin-bottom: 15px;
        }
        .highlight {
            background: #FFB80020;
        }
    </style>
</head>

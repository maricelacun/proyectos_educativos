    ];
    const compGrid = document.getElementById("compGrid");
    compGrid.innerHTML = components.map(c => `<div class="card" style="border-left-color: ${c.color};" onclick="showComponentModal('${c.nombre}', '⚡ Función: ${c.funcion} \\n📐 Símbolo: ${c.simbolo} \\n💡 Aplicación: ${c.practica}')"><i class="${c.icono}" style="font-size:2.2rem; color:${c.color};"></i><h3>${c.nombre}</h3><p>${c.funcion}</p><small>🔌 ${c.practica}</small></div>`).join('');

    function showComponentModal(title, desc) {
        document.getElementById("modalTitle").innerText = title;
        document.getElementById("modalDesc").innerText = desc;
        document.getElementById("componentModal").style.display = "flex";
    }
    window.closeModal = () => document.getElementById("componentModal").style.display = "none";

    // Acordeones de funcionamiento
    const componentsAcc = ["LED", "Resistencia", "Potenciometro", "LDR", "Batería 9V"];
    const accDesc = {
        "LED":"🔴 Convierte corriente en luz. Ánodo (+) largo, cátodo (-) corto.",
        "Resistencia":"🟡 Limita corriente, valor en bandas de colores: ¡protege el LED!",
        "Potenciometro":"🟠 Resistencia variable: al girar cambia el voltaje o intensidad.",
        "LDR":"☀️ Resistencia baja con luz alta, alta en oscuridad. Ideal para proyectos automáticos.",
        "Batería 9V":"🔵 Entrega 9V CC; respetar polaridad rojo (+) y negro (-)."
    };
    const accHtml = componentsAcc.map(comp => `<button class="accordion">🔹 ${comp}</button><div class="panel"><p>${accDesc[comp]}</p></div>`).join('');
    document.getElementById("accordionContainer").innerHTML = accHtml;
    document.querySelectorAll(".accordion").forEach(btn => {
        btn.addEventListener("click", function() { let panel = this.nextElementSibling; panel.style.display = panel.style.display === "block" ? "none" : "block"; });
    });

    // Quiz 10 preguntas (versión entretenida)
    const questions = [
        { text:"¿Qué componente limita la corriente en un circuito para proteger un LED?", options:["LED","Resistencia","Batería","Interruptor"], correct:1 },
        { text:"¿Para qué sirve un potenciómetro?", options:["Variar resistencia","Almacenar energía","Emitir luz","Cortar corriente"], correct:0 },
        { text:"Material reciclable ideal para la estructura base:", options:["Cartón","Vidrio roto","Plástico virgen","Aluminio puro"], correct:0 },
        { text:"¿Qué emite luz cuando la corriente fluye?", options:["LDR","LED","Condensador","Potenciometro"], correct:1 },
        { text:"¿Cuál componente es sensible a la luz y cambia su resistencia?", options:["LDR","Resistencia fija","Transistor","Diodo"], correct:0 },
        { text:"Símbolo clásico de un interruptor:", options:["─▭─","─||─","─o/ o─","─>─"], correct:2 },
        { text:"¿Cómo se llama el camino cerrado por donde circula la corriente?", options:["Circuito abierto","Circuito electrónico","Corto circuito","Red abierta"], correct:1 },
        { text:"¿Qué voltaje entrega una batería cuadrada pequeña?", options:["3V","9V","12V","1.5V"], correct:1 },
        { text:"Ejemplo de proyecto automático usando LDR:", options:["Semáforo fijo","Lámpara que enciende de noche","Radio FM","Motor DC"], correct:1 },
        { text:"Beneficio principal de usar reciclaje en este proyecto:", options:["Mayor costo","Reutilización de residuos","Electrónica compleja","Más consumo"], correct:1 }
    ];
    const quizDiv = document.getElementById("quizArea");
    let quizHtml = "";
    questions.forEach((q, idx) => {
        quizHtml += `<div class="question"><p><strong>${idx+1}. ${q.text}</strong></p>`;
        q.options.forEach((opt, optIdx) => {
            quizHtml += `<label style="display:inline-block; margin-right:20px;"><input type="radio" name="q${idx}" value="${optIdx}"> ${opt}</label>`;
        });
        quizHtml += `</div>`;
    });
    quizDiv.innerHTML = quizHtml;
    document.getElementById("submitQuiz").addEventListener("click", () => {
        let score = 0;
        for(let i=0; i<questions.length; i++) {
            let selected = document.querySelector(`input[name="q${i}"]:checked`);
            if(selected && parseInt(selected.value) === questions[i].correct) score++;
        }
        document.getElementById("quizResultado").innerHTML = `🎉 Puntaje: ${score}/${questions.length} 🎉 ${score>=7 ? "✅ ¡Genio de la electrónica!" : "💪 ¡Sigue practicando, el reciclaje y la tecnología te esperan!"}`;
    });

    // Intersection observer
    const sections = document.querySelectorAll("section");
    const observer = new IntersectionObserver((entries) => { entries.forEach(entry => { if(entry.isIntersecting) entry.target.classList.add("visible"); }); }, { threshold:0.1 });
    sections.forEach(sec => observer.observe(sec));
    document.getElementById("exploreBtn").addEventListener("click", () => document.getElementById("intro").scrollIntoView({ behavior: "smooth" }));
    window.addEventListener("load", () => { sections.forEach(sec => { if(sec.getBoundingClientRect().top < window.innerHeight) sec.classList.add("visible"); }); });
</script>
</body>
</html>
